# Create a GonkaRouter account without adding a payment method, then put the
# free-credit API key here. This key is only read by the server route.
GONKA_API_KEY=

# Optional. These defaults are the three active Gonka network models used by
# TrustLens. Override them only if Gonka changes its approved model IDs.
GONKA_BASE_URL=https://api.gonkarouter.io/v1
GONKA_MODEL_A=MiniMaxAI/MiniMax-M2.7
GONKA_MODEL_B=moonshotai/Kimi-K2.6
GONKA_MODEL_C=deepseek-ai/DeepSeek-V4-Flash-0731

# Publish move/ to Sui Testnet, then paste the returned package ID here.
# This is public blockchain metadata and is safe to expose to the browser.
NEXT_PUBLIC_SUI_PACKAGE_ID=
